# Copy this to .env and fill in your values
# cp .env.example .env

OPENAI_API_KEY=sk-...

# Which Codex model to use
# I was testing with code-davinci-002 but credits ran out
# Fell back to gpt-3.5-turbo for the planner parts
CODEX_MODEL=code-davinci-002
FALLBACK_MODEL=gpt-3.5-turbo

# Scraping config
HEADLESS_BROWSER=true
REQUEST_DELAY_SECONDS=1.5    # be polite, don't hammer the servers
MAX_RESULTS_PER_PLATFORM=30

# Where reports get saved
REPORT_OUTPUT_DIR=./reports
